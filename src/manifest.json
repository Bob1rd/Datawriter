{
  "manifest_version": 3,
  "name": "__MSG_manifest_name__",
  "version": "0.5.0",
  "version_name": "Beta 0.5",
  "author": "CU Amnesty International",
  "description": "__MSG_manifest_description__",
  "default_locale": "en",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "__MSG_manifest_action_title__",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Alt+Shift+D" },
      "description": "__MSG_manifest_command_open__"
    }
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://trackdatacenters.com/*"],
      "js": ["i18n.js", "states.js", "finder.js", "perspectives.js", "letter.js", "panel-css.js", "panel.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["data/*.js", "data/leaders/*.js", "data/photos/*.js", "about.html", "icons/icon-48.png"],
      "matches": ["https://trackdatacenters.com/*"]
    }
  ],
  "permissions": ["storage", "scripting", "unlimitedStorage"],
  "host_permissions": [
    "https://trackdatacenters.com/*",
    "https://api.zippopotam.us/*"
  ]
}
